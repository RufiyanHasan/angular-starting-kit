# Rendered by the nginx image's entrypoint (envsubst): ${CSP_CONNECT_SRC} comes from the
# environment. nginx's own $variables are left alone because only defined env vars are replaced.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Scripts are restricted further by the CSP <meta> that Angular's autoCsp writes into
    # index.html (hashes + strict-dynamic). Both policies must pass, so inline scripts that
    # aren't hashed are still blocked.
    set $csp "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ${CSP_CONNECT_SRC}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    # Liveness probe for Docker / Kubernetes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Content-hashed build output (main-AB12CD34.js, chunk-*.js, styles-*.css, media/*):
    # the name changes whenever the content does, so cache it forever.
    location ~* ^/(?:(?:main|polyfills|styles|chunk)-[\w-]+\.(?:js|css)|media/.+)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Runtime config and translations change per deploy without a rebuild: always revalidate.
    # A missing file is a real 404, not the SPA fallback.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Service worker for the mock API (only used when mockApi is true). Must never be stale.
    location = /mockServiceWorker.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Everything else is an app route: serve index.html, never cached, so a deploy is picked
    # up on the next navigation.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
